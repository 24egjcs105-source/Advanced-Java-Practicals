<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Checkout | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/">ShopSphere<span>.</span></a><nav><a href="${pageContext.request.contextPath}/">Home</a><a href="${pageContext.request.contextPath}/cart">Cart 🛒</a></nav></header><main class="page narrow"><p class="eyebrow">ALMOST THERE</p><h1 class="page-title">Checkout</h1><p class="muted">Enter your details to place this demo order.</p><form class="checkout-form" method="post" action="${pageContext.request.contextPath}/checkout"><% if(request.getAttribute("error")!=null){ %><p class="error">${error}</p><% } %><label>Full name<input type="text" name="name" placeholder="Your name" required></label><label>Email address<input type="email" name="email" placeholder="you@example.com" required></label><label>Delivery address<textarea name="address" rows="3" placeholder="House no., street, city, PIN code" required></textarea></label><button class="button full" type="submit">Place demo order →</button><p class="secure">This lab demo does not take payments or save order data.</p></form></main><footer>ShopSphere <span>·</span> Java E-Commerce Lab Project</footer></body></html>