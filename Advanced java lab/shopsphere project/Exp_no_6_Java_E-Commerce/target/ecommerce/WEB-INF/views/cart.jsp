<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your Cart | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/">ShopSphere<span>.</span></a><nav><a href="${pageContext.request.contextPath}/">Home</a><a class="active" href="${pageContext.request.contextPath}/cart">Cart 🛒</a></nav></header><main class="page"><p class="eyebrow">YOUR SELECTION</p><h1 class="page-title">Shopping cart</h1>
<c:choose><c:when test="${empty cartItems}"><div class="empty"><div>🛒</div><h2>Your cart is waiting</h2><p>Add something you like from our collection.</p><a class="button" href="${pageContext.request.contextPath}/">Browse products →</a></div></c:when><c:otherwise><div class="cart-layout"><section class="cart-list"><c:forEach var="item" items="${cartItems}"><article class="cart-row"><div class="cart-emoji">${item.product.emoji}</div><div class="cart-detail"><h3>${item.product.name}</h3><p>₹${item.product.price} each</p><div class="qty"><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="id" value="${item.product.id}"><input type="hidden" name="action" value="decrease"><button type="submit">−</button></form><span>${item.quantity}</span><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="id" value="${item.product.id}"><input type="hidden" name="action" value="add"><button type="submit">+</button></form></div></div><div class="cart-price"><strong>₹${item.subtotal}</strong><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="id" value="${item.product.id}"><input type="hidden" name="action" value="remove"><button class="remove" type="submit">Remove</button></form></div></article></c:forEach></section><aside class="summary"><h2>Order summary</h2><div class="summary-line"><span>Subtotal</span><strong>₹${total}</strong></div><div class="summary-line"><span>Delivery</span><strong class="green">Free</strong></div><hr><div class="summary-line total"><span>Total</span><strong>₹${total}</strong></div><a class="button full" href="${pageContext.request.contextPath}/checkout">Proceed to checkout →</a><p class="secure">✓ &nbsp; Demo checkout · No real payment</p></aside></div></c:otherwise></c:choose></main><footer>ShopSphere <span>·</span> Java E-Commerce Lab Project</footer></body></html>