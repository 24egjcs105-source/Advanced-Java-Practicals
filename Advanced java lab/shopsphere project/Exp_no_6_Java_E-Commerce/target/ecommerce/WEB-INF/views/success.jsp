<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Order placed | ShopSphere</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/">ShopSphere<span>.</span></a><nav><a href="${pageContext.request.contextPath}/">Home</a></nav></header><main class="page"><section class="success"><div class="success-icon">✓</div><p class="eyebrow">ORDER CONFIRMED</p><h1>Thanks, ${name}!</h1><p>Your demo order has been placed successfully.</p><div class="receipt"><div><span>Customer</span><strong>${name}</strong></div><div><span>Email</span><strong>${email}</strong></div><div><span>Order total</span><strong>₹${total}</strong></div><div><span>Delivery address</span><strong>${address}</strong></div></div><a class="button" href="${pageContext.request.contextPath}/">Continue shopping →</a></section></main><footer>ShopSphere <span>·</span> Java E-Commerce Lab Project</footer></body></html>