<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ShopSphere | Store</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/">ShopSphere<span>.</span></a><nav><a class="active" href="${pageContext.request.contextPath}/">Home</a><a href="${pageContext.request.contextPath}/cart">Cart 🛒</a></nav></header>
<main><section class="hero"><div><p class="eyebrow">THE EVERYDAY STORE</p><h1>Find your next<br><span>favourite thing.</span></h1><p class="hero-copy">Useful products, thoughtful prices. A simple demo store built with Java.</p><a class="button" href="#products">Shop collection <span>→</span></a></div><div class="hero-art"><div class="art-circle"></div><div class="floating-card">✦ &nbsp; Good finds, every day</div><div class="big-emoji">🛍️</div></div></section>
<section id="products" class="section-head"><div><p class="eyebrow">CURATED FOR YOU</p><h2>Popular products</h2></div><span class="muted">6 items to explore</span></section>
<section class="products"><c:forEach var="p" items="${products}"><article class="product-card"><div class="product-art"><span class="product-emoji">${p.emoji}</span><span class="category">${p.category}</span></div><div class="product-info"><h3>${p.name}</h3><p>${p.description}</p><div class="product-bottom"><strong>₹${p.price}</strong><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="id" value="${p.id}"><input type="hidden" name="action" value="add"><button class="add-button" type="submit" aria-label="Add ${p.name} to cart">+</button></form></div></div></article></c:forEach></section>
</main><footer>ShopSphere <span>·</span> Java E-Commerce Lab Project</footer></body></html>